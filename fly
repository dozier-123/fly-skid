-- SPEED INPUT

speedBox.FocusLost:Connect(function()
	local newSpeed = tonumber(speedBox.Text)

	if newSpeed and newSpeed > 0 then
		flightSpeed = math.clamp(newSpeed, 1, 10000)
		speedBox.Text = tostring(flightSpeed)
	else
		speedBox.Text = tostring(flightSpeed)
	end
end)

-- FLIGHT SYSTEM

local function cleanup()
	if velocity then velocity:Destroy() end
	if orientation then orientation:Destroy() end
	if attachment then attachment:Destroy() end

	velocity = nil
	orientation = nil
	attachment = nil
end

local function createFlight()
	if not flying or not rootPart or not humanoid then return end

	cleanup()

	attachment = Instance.new("Attachment")
	attachment.Parent = rootPart

	velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = rootPart

	orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = attachment
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.Responsiveness = 15
	orientation.MaxTorque = math.huge
	orientation.Parent = rootPart

	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
end

local function setupCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")

	if flying then
		createFlight()
	end
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
	setupCharacter(player.Character)
end

local function toggleFlight()
	if not humanoid or not rootPart then return end

	flying = not flying

	if flying then
		createFlight()
	else
		cleanup()
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

-- INPUT

UIS.InputBegan:Connect(function(input, processed)
	if processed then return end

	if input.KeyCode == Enum.KeyCode.E then
		toggleFlight()
	end

	keys[input.KeyCode] = true
end)

UIS.InputEnded:Connect(function(input)
	keys[input.KeyCode] = false
end)

-- MOVEMENT

RunService.RenderStepped:Connect(function()
	if not flying or not velocity or not rootPart then return end

	local camera = workspace.CurrentCamera
	local direction = Vector3.zero

	local forward = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector

	if keys[Enum.KeyCode.W] then direction += forward end
	if keys[Enum.KeyCode.S] then direction -= forward end
	if keys[Enum.KeyCode.D] then direction += right end
	if keys[Enum.KeyCode.A] then direction -= right end
	if keys[Enum.KeyCode.Space] then direction += Vector3.yAxis end
	if keys[Enum.KeyCode.LeftControl] then direction -= Vector3.yAxis end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	velocity.VectorVelocity = direction * flightSpeed

	local flatForward = Vector3.new(forward.X, 0, forward.Z)

	if flatForward.Magnitude > 0.001 then
		orientation.CFrame = CFrame.lookAt(
			Vector3.zero,
			flatForward
		)
	end
end)

-- REOPEN GUI WITH RIGHT SHIFT
UIS.InputBegan:Connect(function(input, processed)
	if processed then return end

	if input.KeyCode == Enum.KeyCode.RightShift then
		if not frame.Visible and not miniButton.Visible then
			frame.Visible = true
		end
	end
end)
