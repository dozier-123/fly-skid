--==================================================
-- HOT RELOAD / OLD VERSION REMOVAL
--==================================================

_G.__FlightSystem = _G.__FlightSystem or {}

if _G.__FlightSystem.Cleanup then
	pcall(_G.__FlightSystem.Cleanup)
end

-- Remove leftover GUIs
for _, obj in ipairs(playerGui:GetChildren()) do
	if obj.Name == "FlightControlPanel"
		or obj.Name == "FlightControlPanel_Old" then
		obj:Destroy()
	end
end

-- Remove leftover flight objects
local function removeOldFlightObjects()
	local char = player.Character
	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	for _, obj in ipairs(root:GetChildren()) do
		if obj.Name == "FlightAttachment"
			or obj.Name == "FlightVelocity"
			or obj.Name == "FlightOrientation" then
			obj:Destroy()
		end
	end
end

removeOldFlightObjects()

--==================================================
-- VARIABLES
--==================================================

local flightSpeed = 50
local flying = false

local character
local humanoid
local rootPart

local attachment
local velocity
local orientation

local keys = {}
local connections = {}

local gui

local function track(connection)
	table.insert(connections, connection)
	return connection
end

--==================================================
-- CLEANUP
--==================================================

local function cleanupFlight()
	if velocity then
		velocity:Destroy()
		velocity = nil
	end

	if orientation then
		orientation:Destroy()
		orientation = nil
	end

	if attachment then
		attachment:Destroy()
		attachment = nil
	end
end

local function cleanupAll()
	flying = false

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(connections)
	table.clear(keys)

	cleanupFlight()

	if humanoid and humanoid.Parent then
		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end

	if gui then
		gui:Destroy()
		gui = nil
	end

	print("[Flight] Previous version destroyed.")
end

local controller = {
	Version = VERSION,
	Cleanup = cleanupAll
}

_G.__FlightSystem = controller

--==================================================
-- GUI HELPERS
--==================================================

local function corner(object, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = object
end

local function makeLabel(parent, text, size, position)
	local obj = Instance.new("TextLabel")

	obj.Size = size
	obj.Position = position
	obj.BackgroundTransparency = 1
	obj.Text = text
	obj.TextColor3 = Color3.new(1, 1, 1)
	obj.Font = Enum.Font.Gotham
	obj.TextSize = 13
	obj.Parent = parent

	return obj
end

local function makeButton(parent, text, size, position, color)
	local obj = Instance.new("TextButton")

	obj.Size = size
	obj.Position = position
	obj.BackgroundColor3 = color
	obj.Text = text
	obj.TextColor3 = Color3.new(1, 1, 1)
	obj.Font = Enum.Font.GothamBold
	obj.TextSize = 13
	obj.Parent = parent

	corner(obj, 6)

	return obj
end

