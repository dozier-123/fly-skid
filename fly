	if value and value > 0 then
		flightSpeed = math.clamp(value, 1, 10000)
	end

	speedBox.Text = tostring(flightSpeed)
end))

--==================================================
-- FLIGHT
--==================================================

local function createFlight()
	if not flying or not humanoid or not rootPart then
		return
	end

	cleanupFlight()

	attachment = Instance.new("Attachment")
	attachment.Name = "FlightAttachment"
	attachment.Parent = rootPart

	velocity = Instance.new("LinearVelocity")
	velocity.Name = "FlightVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = rootPart

	orientation = Instance.new("AlignOrientation")
	orientation.Name = "FlightOrientation"
	orientation.Attachment0 = attachment
	orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orientation.Responsiveness = 15
	orientation.MaxTorque = math.huge
	orientation.Parent = rootPart

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)
end

--==================================================
-- CHARACTER
--==================================================

local function setupCharacter(char)
	character = char

	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")

	if flying then
		createFlight()
	end
end

track(player.CharacterAdded:Connect(setupCharacter))

track(player.CharacterRemoving:Connect(function()
	cleanupFlight()

	humanoid = nil
	rootPart = nil
	character = nil
end))

if player.Character then
	task.spawn(setupCharacter, player.Character)
end

--==================================================
-- TOGGLE
--==================================================

local function toggleFlight()
	if not humanoid or not rootPart then
		return
	end

	flying = not flying

	if flying then
		createFlight()
	else
		cleanupFlight()

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end
end

--==================================================
-- KEYBOARD
--==================================================

track(UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.E then
		toggleFlight()
	end

	keys[input.KeyCode] = true
end))

track(UIS.InputEnded:Connect(function(input)
	keys[input.KeyCode] = false
end))

--==================================================
-- MOVEMENT
--==================================================

track(RunService.RenderStepped:Connect(function()
	if not flying or not velocity or not rootPart then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then return end

	local direction = Vector3.zero

	local forward = camera.CFrame.LookVector
	local right = camera.CFrame.RightVector

	if keys[Enum.KeyCode.W] then
		direction += forward
	end

	if keys[Enum.KeyCode.S] then
		direction -= forward
	end

	if keys[Enum.KeyCode.D] then
		direction += right
	end

	if keys[Enum.KeyCode.A] then
		direction -= right
	end

	if keys[Enum.KeyCode.Space] then
		direction += Vector3.yAxis
	end

	if keys[Enum.KeyCode.LeftControl] then
		direction -= Vector3.yAxis
	end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	velocity.VectorVelocity = direction * flightSpeed

	local flatForward = Vector3.new(
		forward.X,
		0,
		forward.Z
	)

	if flatForward.Magnitude > 0.001 then
		orientation.CFrame = CFrame.lookAt(
			Vector3.zero,
			flatForward
		)
	end
end))

